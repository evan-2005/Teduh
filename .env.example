# Server only. Never prefix with VITE_.
ANTHROPIC_API_KEY=
# Which AI the server uses. "ollama" runs a free local model (install Ollama, then
# "ollama pull qwen2.5vl:7b"; see docs/LOCAL-AI.md). Remove this line to use Claude via
# ANTHROPIC_API_KEY instead. With neither, the AI scan returns labelled MOCK results.
AI_PROVIDER=ollama
# The model must support images. qwen2.5vl:7b is what the demo uses; on a laptop with
# less than 6 GB of graphics memory try gemma3:4b (and pull that one instead).
OLLAMA_MODEL=qwen2.5vl:7b
# Ollama's address (default shown).
# OLLAMA_URL=http://localhost:11434
# Optional: how long to wait for the local model, in ms (default 60000; the first call loads it).
# OLLAMA_TIMEOUT_MS=60000
# Shows the AI scan page. Read when the app starts or is built, so restart npm run dev
# (or rebuild before npm run preview) after changing it.
VITE_ENABLE_AI=true
# Set to seed to force the invented offline neighbourhood (tests use this). Normally unset;
# pick an area in the app, or open /?area=<slug>.
# VITE_DATASET=seed
