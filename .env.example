# Server only. Never prefix with VITE_.
ANTHROPIC_API_KEY=
# Which AI the server uses. "ollama" runs a local model (see docs/LOCAL-AI.md).
# Unset: Claude if ANTHROPIC_API_KEY is set, otherwise labelled MOCK results.
# AI_PROVIDER=ollama
# Ollama server and model (defaults shown). The model must support vision for the shade scan.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# Optional: how long to wait for the local model, in ms (default 60000; the first call loads it).
# OLLAMA_TIMEOUT_MS=60000
# Set to true to show the AI scan + plan explainer.
VITE_ENABLE_AI=false
# Set to seed to force the invented offline neighbourhood (tests use this). Normally unset;
# pick an area in the app, or open /?area=<slug>.
# VITE_DATASET=seed
